# Copy to server/.env — the server loads it from its working directory at boot.
# All keys are optional when every Agent node uses the "Mock" provider.

# OpenAI or any OpenAI-compatible endpoint (Ollama, LM Studio, vLLM, OpenRouter)
OPENAI_API_KEY=
# OPENAI_BASE_URL is set per node via the "Base URL" field instead.

ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# API port (Vite dev server proxies /api here)
PORT=5175

# SQLite file location, relative to the server's working directory
# AGENT_MAKER_DB=data/agent_maker.db
